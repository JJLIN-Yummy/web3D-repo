pipeline {
    agent any
    tools {
        nodejs 'node20'
    }
    environment {
        PNPM_STORE_DIR = "/var/jenkins_home/pnpm-store"
        PNPM_CACHE_DIR = "/var/jenkins_home/pnpm-cache"
    }
    stages {
        stage('安装依赖打包') {
            steps {
                sh '''
                    curl -v http://127.0.0.1:4873
                    export PNPM_FETCH_IGNORE_BUILDS=false
                    npm config set registry https://registry.npmmirror.com

                    # 仅安装pnpm到node_modules，用来获取本地二进制，不装全量依赖
                    npm install pnpm

                    # 调用项目本地pnpm二进制，完全不触发Corepack
                    ./node_modules/.bin/pnpm config set store-dir ${PNPM_STORE_DIR}
                    ./node_modules/.bin/pnpm config set cache-dir ${PNPM_CACHE_DIR}
                    ./node_modules/.bin/pnpm config set registry https://registry.npmmirror.com
                    ./node_modules/.bin/pnpm config list

                    # 删除临时node_modules，用pnpm读取pnpm-lock.yaml完整安装
                    rm -rf node_modules
                    ./node_modules/.bin/pnpm install

                    export NODE_OPTIONS="--max-old-space-size=1200"
                    ./node_modules/.bin/pnpm run build:ci-demo
                '''
            }
        }
        stage('人工确认上线') {
            steps {
                input message: "确认上传 dist 到服务器 /web ？", ok: "确认上线"
            }
        }
        stage('上传 dist 文件') {
            steps {
                sshPublisher(
                    publishers: [
                        sshPublisherDesc(
                            configName: 'server-01',
                            transfers: [
                                sshTransfer(
                                    sourceFiles: 'packages/ci-demo/dist/**',
                                    remoteDirectory: '/web',
                                    cleanRemote: true,
                                    removePrefix: 'packages/ci-demo/dist'
                                )
                            ]
                        )
                    ]
                )
            }
        }
        stage('重载 Nginx') {
            steps {
                sshPublisher(
                    publishers: [
                        sshPublisherDesc(
                            configName: 'server-01',
                            configs: [
                                sshCommand(command: 'docker exec mynginx nginx -s reload')
                            ]
                        )
                    ]
                )
            }
        }
    }
    post {
        always {
            sh '''
                rm -rf packages/ci-demo/dist
            '''
        }
        success {
            echo "✅ 部署完成！文件上传到 /web，mynginx 已重载"
        }
        failure {
            echo "❌ 流水线失败，查看日志"
        }
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timeout(time: 20, unit: 'MINUTES')
    }
}
