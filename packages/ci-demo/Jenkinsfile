pipeline {
    agent none
    tools {
        nodejs 'node20'
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    stages {
        stage('安装依赖打包') {
            agent { label 'master' }
            steps {
                sh '''
                    curl -v http://127.0.0.1:4873
                    export COREPACK_ENABLE_STRICT=0
                    export COREPACK_ENABLE_AUTO_PIN=0
                    export PNPM_FETCH_IGNORE_BUILDS=false
                    export NODE_OPTIONS="--max-old-space-size=8192"
                    corepack disable
                    npm config set registry https://registry.npmmirror.com
                    rm -rf packages/ci-demo/dist
                    npx pnpm config list
                    npx pnpm install --frozen-lockfile
                    # 下面这一行是修复后的打包命令
                    npx pnpm run build:ci-demo
                '''
            }
            post {
                always {
                    stash includes: 'packages/ci-demo/dist/**', name: 'dist-artifact'
                }
            }
        }
        stage('人工确认上线') {
            steps {
                input message: "确认上传 packages/ci-demo/dist 到服务器 /web ？", ok: "确认上线"
            }
        }
        stage('上传dist + 重载nginx') {
            agent { label 'master' }
            steps {
                unstash 'dist-artifact'
                sshPublisher(
                    publishers: [
                        sshPublisherDesc(
                            configName: 'server-01',
                            transfers: [
                                sshTransfer(
                                    sourceFiles: 'packages/ci-demo/dist/**',
                                    remoteDirectory: '/web',
                                    cleanRemote: true,
                                    removePrefix: 'packages/ci-demo/dist'
                                )
                            ]
                        )
                    ]
                )
                sshPublisher(
                    publishers: [
                        sshPublisherDesc(
                            configName: 'server-01',
                            transfers: [
                                sshTransfer(
                                    command: 'docker exec mynginx nginx -s reload'
                                )
                            ]
                        )
                    ]
                )
            }
        }
    }
    post {
        always {
            echo "流水线执行结束"
        }
        success {
            echo "✅ ci-demo部署完成！文件上传到 /web，mynginx 已重载。"
        }
        failure {
            echo "❌ ci-demo流水线失败，查看日志"
        }
    }
}
