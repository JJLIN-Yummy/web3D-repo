pipeline {
    agent any
    tools {
        nodejs 'node20'
    }
    environment {
        PNPM_STORE_DIR = "/var/jenkins_home/pnpm-store"
        PNPM_CACHE_DIR = "/var/jenkins_home/pnpm-cache"
    }
    stages {
        stage('安装依赖打包') {
            steps {
                sh '''
                    curl -v http://127.0.0.1:4873
                    export COREPACK_ENABLE_STRICT=0
                    export PNPM_FETCH_IGNORE_BUILDS=false
                    # 切换npm镜像
                    npm config set registry https://registry.npmmirror.com

                    # === 一次性任务已经全局安装pnpm并corepack disable，移除重复安装逻辑 ===
                    # pnpm -v >/dev/null 2>&1 || npm install -g pnpm

                    # pnpm全局配置（只首次生效，重复执行无害）
                    pnpm config set store-dir ${PNPM_STORE_DIR}
                    pnpm config set cache-dir ${PNPM_CACHE_DIR}
                    pnpm config set registry https://registry.npmmirror.com
                    pnpm config list

                    # 删除项目本地node_modules，全局store保留
                    rm -rf node_modules
                    pnpm install

                    # 限制Node堆内存，2G机器设置1200MB，OOM时可改成1024
                    export NODE_OPTIONS="--max-old-space-size=1200"
                    pnpm run build:ci-demo
                '''
            }
        }
        stage('人工确认上线') {
            steps {
                input message: "确认上传 dist 到服务器 /web ？", ok: "确认上线"
            }
        }
        stage('上传 dist 文件') {
            steps {
                sshPublisher(
                    publishers: [
                        sshPublisherDesc(
                            configName: 'server-01',
                            transfers: [
                                sshTransfer(
                                    sourceFiles: 'packages/ci-demo/dist/**',
                                    remoteDirectory: '/web',
                                    cleanRemote: true,
                                    removePrefix: 'packages/ci-demo/dist'
                                )
                            ]
                        )
                    ]
                )
            }
        }
        stage('重载 Nginx') {
            steps {
                sshPublisher(
                    publishers: [
                        sshPublisherDesc(
                            configName: 'server-01',
                            configs: [
                                sshCommand(command: 'docker exec mynginx nginx -s reload')
                            ]
                        )
                    ]
                )
            }
        }
    }
    post {
        always {
            # 只删除本次构建产出的dist静态文件，保留pnpm全局缓存
            sh '''
                rm -rf packages/ci-demo/dist
            '''
        }
        success {
            echo "✅ 部署完成！文件上传到 /web，mynginx 已重载"
        }
        failure {
            echo "❌ 流水线失败，查看日志"
        }
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '5')) // 只保留最近5次构建，控制工作区磁盘
        timeout(time: 20, unit: 'MINUTES') // 20分钟超时，防止进程卡死占用内存
    }
}
