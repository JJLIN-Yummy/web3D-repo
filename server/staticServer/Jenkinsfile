pipeline {
    agent any
    tools {
        nodejs 'node20'
    }
    environment {
        VITE_OSS_REGION = credentials('VITE_OSS_REGION')
        VITE_OSS_ACCESS_KEY_ID = credentials('VITE_OSS_ACCESS_KEY_ID')
        VITE_OSS_ACCESS_KEY_SECRET = credentials('VITE_OSS_ACCESS_KEY_SECRET')
        VITE_OSS_BUCKET = credentials('VITE_OSS_BUCKET')
        VITE_PORT = credentials('VITE_PORT')
    }
    stages {
        stage('安装依赖 & 编译（宿主机执行）') {
            steps {
                sh """
                corepack enable
                pnpm install --filter @web3d/staticServer...
                pnpm -F @web3d/staticServer build
                """
            }
        }
        stage('构建运行镜像') {
            steps {
                sh """
                docker build -t static-server -f ./server/staticServer/Dockerfile .
                """
            }
        }
        stage('停止旧容器') {
            steps {
                sh """
                # -t 30：SIGTERM最多等待30秒优雅关闭，超时强制kill
                docker stop -t 30 static-server || true
                docker rm static-server || true
                """
            }
        }
        stage('启动新容器') {
            steps {
                sh '''
                docker run -d \
                  -p 3000:3000 \
                  --name static-server \
                  -e VITE_OSS_REGION \
                  -e VITE_OSS_ACCESS_KEY_ID \
                  -e VITE_OSS_ACCESS_KEY_SECRET \
                  -e VITE_OSS_BUCKET \
                  -e VITE_PORT \
                  static-server
                '''
            }
        }
        stage('健康检查') {
            steps {
                sh '''
                # 循环探测 /health，最多30秒等待启动
                for i in {1..30}; do
                  if curl -s http://127.0.0.1:3000/health | grep ok; then
                    echo "✅ 服务健康检查通过"
                    break
                  fi
                  echo "等待服务启动..."
                  sleep 1
                done
                # 校验，失败直接流水线报错
                curl -s http://127.0.0.1:3000/health | grep ok
                '''
            }
        }
        stage('清理悬空镜像') {
            steps {
                sh "docker image prune -f"
            }
        }
    }
    post {
        always {
            echo "流水线执行完毕"
        }
        failure {
            echo "❌ 部署失败，请检查日志，旧容器已经停止，需要手动回滚镜像"
        }
    }
}
